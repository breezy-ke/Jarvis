# Jarvis environment. Copy to `.env` and run `make secrets` to fill in the
# generated values. Never commit `.env`: it is gitignored.

# --- Core --------------------------------------------------------------------
JARVIS_ENV=production                 # production | development | test
JARVIS_TIMEZONE=Africa/Nairobi
# The exact HTTPS address you open Jarvis at, e.g. from `tailscale serve`.
# Passkeys are bound to this address.
JARVIS_PUBLIC_ORIGIN=https://your-pc.your-tailnet.ts.net
# Encrypts OAuth tokens and email bodies at rest (Fernet key). Generated by
# `make secrets`. Back it up somewhere safe: losing it makes encrypted data
# unreadable.
JARVIS_SECRET_KEY=
JARVIS_SESSION_TTL_HOURS=720

# --- Database ------------------------------------------------------------------
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://jarvis:${POSTGRES_PASSWORD}@postgres:5432/jarvis

# --- Model providers (all optional; see config/models.yaml) --------------------
OLLAMA_BASE_URL=http://ollama:11434/v1
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Paid providers stay off until budget.monthly_usd_cap > 0 in config/models.yaml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Google (Gmail / Calendar) -----------------------------------------------
# A "Desktop app" OAuth client from Google Cloud Console. Set the consent
# screen to "In production" (personal use) so tokens don't expire after 7 days.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- GitHub (optional: lets profile ingestion read private repos) --------------
GITHUB_TOKEN=

# --- Web push notifications (generated by `make secrets`) ----------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Tracing (Phoenix runs locally in docker compose; traces never leave your PC)
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces

# --- Self-hosted web search (Phase 4; generated by `make secrets`) -----------------
SEARXNG_SECRET=
